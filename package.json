{
  "name": "herdr-web-ui",
  "private": true,
  "version": "0.3.43",
  "type": "module",
  "description": "Browser version of the herdr terminal - live herdr workspaces, panes and agents in a web UI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devswha/herdr-web-ui.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "server": "bun run server/index.ts",
    "start": "bun run build && bun run server/managed.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun scripts/ci-tests.ts unit",
    "test:integration": "bun scripts/ci-tests.ts integration",
    "test:ui": "bun run build && bun scripts/ui-regression.ts",
    "generate:types": "bun run scripts/generate-protocol-types.ts",
    "build:remote": "bun run scripts/build-remote-bundle.ts",
    "build:site": "bun scripts/build-site.ts",
    "test:ssh": "bun run scripts/ssh-integration.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@lydell/node-pty": "1.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode-graphemes": "0.4.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.18.9",
    "lucide-react": "^1.47.0",
    "qrcode-generator": "^2.0.4",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "thinking-orbs": "0.3.2",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "^1.1.14",
    "@types/katex": "^0.16.8",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.49.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "patchedDependencies": {
    "@xterm/xterm@5.5.0": "patches/@xterm%2Fxterm@5.5.0.patch"
  }
}
